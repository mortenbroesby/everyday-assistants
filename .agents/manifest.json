{
  "schemaVersion": 1,
  "metadata": {
    "purpose": "Discover the repository's durable agent instructions, skills, and supporting workflow artifacts.",
    "authority": "This manifest discovers guidance; it does not override guidance or authorize action. The referenced instructions remain authoritative."
  },
  "artifacts": [
    {
      "id": "agent-artifact-manifest",
      "kind": "manifest",
      "path": ".agents/manifest.json",
      "scope": "repository",
      "summary": "Machine-readable inventory and task router."
    },
    {
      "id": "root-instructions",
      "kind": "instruction",
      "path": "AGENTS.md",
      "scope": "repository",
      "summary": "Repository-wide authority, workflow, and routing instructions.",
      "readBefore": ["nemlig-instructions", "nemlig-claude-compatibility"]
    },
    {
      "id": "definition-of-ready",
      "kind": "instruction",
      "path": ".agents/instructions/definition-of-ready.md",
      "scope": "repository",
      "summary": "Entry criteria for repository changes.",
      "readBefore": ["definition-of-done"]
    },
    {
      "id": "repository-workflow",
      "kind": "instruction",
      "path": ".agents/instructions/repository-workflow.md",
      "scope": "repository",
      "summary": "Repository planning, coordination, verification, and delivery mechanics."
    },
    {
      "id": "definition-of-done",
      "kind": "instruction",
      "path": ".agents/instructions/definition-of-done.md",
      "scope": "repository",
      "summary": "Completion and verification criteria for repository changes."
    },
    {
      "id": "nemlig-instructions",
      "kind": "instruction",
      "path": "apps/nemlig-assistant/AGENTS.md",
      "scope": "apps/nemlig-assistant",
      "summary": "Scoped Nemlig Assistant safety and implementation guidance.",
      "readBefore": ["nemlig-basket", "nemlig-production"]
    },
    {
      "id": "nemlig-claude-compatibility",
      "kind": "instruction",
      "path": "apps/nemlig-assistant/CLAUDE.md",
      "scope": "apps/nemlig-assistant",
      "summary": "Claude-compatible pointer to the scoped Nemlig instructions."
    },
    {
      "id": "code-simplification",
      "kind": "skill",
      "path": ".agents/skills/code-simplification/SKILL.md",
      "scope": "repository",
      "summary": "Behavior-preserving clarity refactoring guidance.",
      "skillName": "code-simplification"
    },
    {
      "id": "design-pattern",
      "kind": "skill",
      "path": ".agents/skills/design-pattern/SKILL.md",
      "scope": "repository",
      "summary": "Explicit design-pattern selection guidance.",
      "skillName": "design-pattern"
    },
    {
      "id": "design-pattern-references",
      "kind": "collection",
      "path": ".agents/skills/design-pattern",
      "scope": "repository",
      "summary": "Reference catalog used by the design-pattern skill.",
      "dependsOn": ["design-pattern"]
    },
    {
      "id": "functional-refactoring",
      "kind": "skill",
      "path": ".agents/skills/functional-refactoring/SKILL.md",
      "scope": "repository",
      "summary": "Functional refactoring guidance.",
      "skillName": "functional-refactoring"
    },
    {
      "id": "roadmap-triage",
      "kind": "skill",
      "path": ".agents/skills/roadmap-triage/SKILL.md",
      "scope": "repository",
      "summary": "Evidence-backed short-to-long-term roadmap prioritization guidance.",
      "skillName": "roadmap-triage"
    },
    {
      "id": "agent-artifact-maintenance",
      "kind": "skill",
      "path": ".agents/skills/agent-artifact-maintenance/SKILL.md",
      "scope": "repository",
      "summary": "Safe inventory, routing, and validation maintenance guidance.",
      "skillName": "agent-artifact-maintenance"
    },
    {
      "id": "openspec-explore",
      "kind": "skill",
      "path": ".agents/skills/openspec-explore/SKILL.md",
      "scope": "repository",
      "summary": "OpenSpec discovery and investigation guidance.",
      "skillName": "openspec-explore"
    },
    {
      "id": "openspec-propose",
      "kind": "skill",
      "path": ".agents/skills/openspec-propose/SKILL.md",
      "scope": "repository",
      "summary": "OpenSpec proposal creation guidance.",
      "skillName": "openspec-propose"
    },
    {
      "id": "openspec-update-change",
      "kind": "skill",
      "path": ".agents/skills/openspec-update-change/SKILL.md",
      "scope": "repository",
      "summary": "OpenSpec change continuation guidance.",
      "skillName": "openspec-update-change"
    },
    {
      "id": "openspec-apply-change",
      "kind": "skill",
      "path": ".agents/skills/openspec-apply-change/SKILL.md",
      "scope": "repository",
      "summary": "OpenSpec implementation guidance.",
      "skillName": "openspec-apply-change"
    },
    {
      "id": "openspec-sync-specs",
      "kind": "skill",
      "path": ".agents/skills/openspec-sync-specs/SKILL.md",
      "scope": "repository",
      "summary": "OpenSpec delta-to-main specification sync guidance.",
      "skillName": "openspec-sync-specs"
    },
    {
      "id": "openspec-archive-change",
      "kind": "skill",
      "path": ".agents/skills/openspec-archive-change/SKILL.md",
      "scope": "repository",
      "summary": "OpenSpec change archival guidance.",
      "skillName": "openspec-archive-change"
    },
    {
      "id": "openspec-target",
      "kind": "configuration",
      "path": ".agents/skills/.openspec-target",
      "scope": "repository",
      "summary": "Agent target used by the OpenSpec skill tooling."
    },
    {
      "id": "openspec-config",
      "kind": "configuration",
      "path": "openspec/config.yaml",
      "scope": "repository",
      "summary": "Repository OpenSpec conventions and schema configuration."
    },
    {
      "id": "openspec-specs",
      "kind": "collection",
      "path": "openspec/specs",
      "scope": "repository",
      "summary": "Authoritative current OpenSpec capabilities."
    },
    {
      "id": "openspec-changes",
      "kind": "collection",
      "path": "openspec/changes",
      "scope": "repository",
      "summary": "Active and archived OpenSpec changes."
    },
    {
      "id": "repository-command-router",
      "kind": "configuration",
      "path": "package.json",
      "scope": "repository",
      "summary": "Repository verification and task command entry points."
    },
    {
      "id": "nemlig-skill-index",
      "kind": "index",
      "path": "apps/nemlig-assistant/.codex/skills/README.md",
      "scope": "apps/nemlig-assistant",
      "summary": "Human-readable index of Nemlig-specific skills."
    },
    {
      "id": "nemlig-basket",
      "kind": "skill",
      "path": "apps/nemlig-assistant/.codex/skills/nemlig-basket/SKILL.md",
      "scope": "apps/nemlig-assistant",
      "summary": "Review-first Nemlig search and basket-operation guidance.",
      "skillName": "nemlig-basket"
    },
    {
      "id": "nemlig-production",
      "kind": "skill",
      "path": "apps/nemlig-assistant/.codex/skills/nemlig-production/SKILL.md",
      "scope": "apps/nemlig-assistant",
      "summary": "Credential-free production readiness and approval boundaries.",
      "skillName": "nemlig-production"
    },
    {
      "id": "pull-request-template",
      "kind": "template",
      "path": ".github/pull_request_template.md",
      "scope": "repository",
      "summary": "Required pull-request evidence structure."
    },
    {
      "id": "continuous-integration",
      "kind": "workflow",
      "path": ".github/workflows/ci.yml",
      "scope": "repository",
      "summary": "Repository pull-request and main verification workflow."
    },
    {
      "id": "nemlig-production-workflow",
      "kind": "workflow",
      "path": ".github/workflows/nemlig-production.yml",
      "scope": "repository",
      "summary": "Post-merge Nemlig deployment and release workflow."
    },
    {
      "id": "privacy-validator",
      "kind": "validator",
      "path": "scripts/check-public-tree.mjs",
      "scope": "repository",
      "summary": "Public-tree privacy boundary validator."
    },
    {
      "id": "agent-artifact-validator",
      "kind": "validator",
      "path": "scripts/check-agent-artifacts.mjs",
      "scope": "repository",
      "summary": "Manifest schema, reference, path, and discovery-drift validator."
    }
  ],
  "routes": [
    {
      "id": "ordinary-repository-work",
      "intent": "Any repository task that does not match a more specific route.",
      "scope": "repository",
      "use": ["root-instructions", "repository-workflow", "definition-of-ready", "definition-of-done"],
      "readBefore": ["root-instructions", "repository-workflow", "definition-of-ready"]
    },
    {
      "id": "openspec-exploration",
      "intent": "Explore an idea or investigate uncertainty before proposing a change.",
      "scope": "repository",
      "use": ["root-instructions", "definition-of-ready", "openspec-config", "openspec-specs", "openspec-changes", "openspec-explore"],
      "readBefore": ["root-instructions", "openspec-config"]
    },
    {
      "id": "openspec-proposal",
      "intent": "Create a new OpenSpec change proposal.",
      "scope": "repository",
      "use": ["root-instructions", "definition-of-ready", "openspec-config", "openspec-specs", "openspec-changes", "openspec-propose"],
      "readBefore": ["root-instructions", "openspec-config"]
    },
    {
      "id": "openspec-update",
      "intent": "Continue or update an existing OpenSpec change.",
      "scope": "repository",
      "use": ["root-instructions", "definition-of-ready", "openspec-config", "openspec-changes", "openspec-update-change"],
      "readBefore": ["root-instructions", "openspec-config"]
    },
    {
      "id": "openspec-implementation",
      "intent": "Implement tasks from an approved OpenSpec change.",
      "scope": "repository",
      "use": ["root-instructions", "definition-of-ready", "definition-of-done", "openspec-config", "openspec-changes", "openspec-apply-change"],
      "readBefore": ["root-instructions", "definition-of-ready", "openspec-config"]
    },
    {
      "id": "openspec-sync",
      "intent": "Sync an OpenSpec change delta into current specifications.",
      "scope": "repository",
      "use": ["root-instructions", "openspec-config", "openspec-specs", "openspec-changes", "openspec-sync-specs"],
      "readBefore": ["root-instructions", "openspec-config"]
    },
    {
      "id": "openspec-archive",
      "intent": "Archive a completed OpenSpec change.",
      "scope": "repository",
      "use": ["root-instructions", "definition-of-done", "openspec-config", "openspec-specs", "openspec-changes", "openspec-archive-change"],
      "readBefore": ["root-instructions", "openspec-config"]
    },
    {
      "id": "simplification",
      "intent": "Simplify working code without changing behavior.",
      "scope": "repository",
      "use": ["root-instructions", "definition-of-ready", "definition-of-done", "code-simplification"],
      "readBefore": ["root-instructions", "code-simplification"]
    },
    {
      "id": "functional-refactor",
      "intent": "Perform an explicitly requested functional-style refactor.",
      "scope": "repository",
      "use": ["root-instructions", "definition-of-ready", "definition-of-done", "functional-refactoring"],
      "readBefore": ["root-instructions", "functional-refactoring"]
    },
    {
      "id": "roadmap-planning",
      "intent": "Inventory, prioritize, or revise a short-to-long-term repository roadmap.",
      "scope": "repository",
      "use": ["root-instructions", "repository-workflow", "openspec-config", "openspec-specs", "openspec-changes", "roadmap-triage"],
      "readBefore": ["root-instructions", "repository-workflow", "roadmap-triage"]
    },
    {
      "id": "agent-artifact-inventory-maintenance",
      "intent": "Add, remove, inventory, or reroute repository agent instructions and skills.",
      "scope": "repository",
      "use": ["root-instructions", "repository-workflow", "agent-artifact-manifest", "agent-artifact-validator", "agent-artifact-maintenance"],
      "readBefore": ["root-instructions", "repository-workflow", "agent-artifact-maintenance"]
    },
    {
      "id": "design-pattern-work",
      "intent": "Apply or evaluate a design pattern when explicitly requested.",
      "scope": "repository",
      "use": ["root-instructions", "definition-of-ready", "definition-of-done", "design-pattern", "design-pattern-references"],
      "readBefore": ["root-instructions", "design-pattern"]
    },
    {
      "id": "nemlig-application-work",
      "intent": "Work anywhere under apps/nemlig-assistant without basket or production operations.",
      "scope": "apps/nemlig-assistant",
      "use": ["root-instructions", "definition-of-ready", "definition-of-done", "nemlig-instructions"],
      "readBefore": ["root-instructions", "nemlig-instructions"]
    },
    {
      "id": "nemlig-basket-operations",
      "intent": "Search Nemlig or prepare, review, apply, or restore basket operations.",
      "scope": "apps/nemlig-assistant",
      "use": ["root-instructions", "nemlig-instructions", "nemlig-basket"],
      "readBefore": ["root-instructions", "nemlig-instructions", "nemlig-basket"]
    },
    {
      "id": "nemlig-production-and-deployment",
      "intent": "Assess production readiness or perform explicitly authorized deployment and provider work.",
      "scope": "apps/nemlig-assistant",
      "use": ["root-instructions", "definition-of-done", "nemlig-instructions", "nemlig-production", "nemlig-production-workflow", "continuous-integration", "privacy-validator"],
      "readBefore": ["root-instructions", "nemlig-instructions", "nemlig-production"]
    }
  ]
}
