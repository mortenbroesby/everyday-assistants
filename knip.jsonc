{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "workspaces": {
    "apps/nemlig-assistant": {
      "entry": [
        "src/cli.ts",
        "src/mcp.ts",
        "src/http.ts",
        "src/cloudflare-worker.ts",
        "src/picker/main.tsx",
        "scripts/auth-local.ts",
        "scripts/auth-local.test.ts",
        "scripts/check-api-manifest.mjs",
        "scripts/check-api-manifest.test.mjs",
        "scripts/check-product-viewer.ts",
        "scripts/coverage.mjs",
        "scripts/production-acceptance.ts",
        "scripts/production-deploy.ts",
        "scripts/production-failure-reasons.ts",
        "scripts/service-token.ts",
        "scripts/smoke-onboarding.ts",
        "scripts/smoke-package.ts",
        "scripts/smoke-product-viewer.ts",
        "scripts/smoke-review-ui.ts",
        "release/agent.ts",
        "release/check-version-bump.ts",
        "release/release-note.ts",
        "release/retry.ts",
        "src/*.test.ts",
        "scripts/*.test.mjs",
        "release/*.test.ts",
        ".storybook/main.ts",
        ".storybook/preview.tsx",
        "tsdown.config.ts",
        "vite.config.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "scripts/**/*.{ts,mjs}",
        "release/**/*.{ts,mjs}",
        ".storybook/**/*.{ts,tsx}",
        "tsdown.config.ts",
        "vite.config.ts"
      ]
    }
  }
}
