{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nemlig-journey-local",
  "main": "src/journey-worker.ts",
  "compatibility_date": "2026-08-31",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/ui-static",
    "not_found_handling": "none"
  },
  "limits": {
    "cpu_ms": 100,
    "subrequests": 8
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "MCP_ENABLED": "true",
    "MCP_CREDENTIAL_ONBOARDING_ENABLED": "false",
    "MCP_AUTH_TIMEOUT_MS": "5000",
    "MCP_CONTROL_TIMEOUT_MS": "3000",
    "MCP_BACKEND_TIMEOUT_MS": "85000",
    "MCP_TOTAL_TIMEOUT_MS": "90000",
    "NEMLIG_MCP_CREDENTIAL_KEY_VERSION": "one",
    "NEMLIG_JOURNEY_TIMING": "true"
  },
  "containers": [
    {
      "class_name": "JourneyContainer",
      "image": "./Dockerfile",
      "image_build_context": "../../",
      "instance_type": "lite",
      "max_instances": 1,
      "constraints": {
        "jurisdiction": "eu"
      },
      "image_vars": {
        "JOURNEY_BUILD": "1"
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NEMLIG_MCP_CONTAINER",
        "class_name": "JourneyContainer"
      },
      {
        "name": "NEMLIG_LOCAL_BASKET_STORAGE",
        "class_name": "OwnerLocalBasketStorage"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["JourneyContainer", "OwnerLocalBasketStorage"]
    }
  ]
}
