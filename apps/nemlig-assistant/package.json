{
  "name": "nemlig-assistant",
  "version": "4.6.0-alpha.69",
  "private": true,
  "description": "Safe local Nemlig Assistant CLI and MCP server",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/mortenbroesby/everyday-assistants#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mortenbroesby/everyday-assistants.git",
    "directory": "apps/nemlig-assistant"
  },
  "bugs": {
    "url": "https://github.com/mortenbroesby/everyday-assistants/issues"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.23.1 <23"
  },
  "bin": {
    "nemlig": "dist/cli.js",
    "nemlig-assistant": "dist/cli.js",
    "nemlig-mcp": "dist/mcp.js",
    "nemlig-mcp-http": "dist/http.js"
  },
  "scripts": {
    "build": "tsdown && vite build && tsx scripts/check-picker.ts",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "cloudflare:check": "wrangler deploy --dry-run --env production",
    "cloudflare:dev": "wrangler dev",
    "cli": "pnpm build && node dist/cli.js",
    "check:version-bump": "tsx release/check-version-bump.ts",
    "check:release-note": "tsx release/release-note.ts",
    "compare:picker": "tsx scripts/compare-picker.ts",
    "lint": "eslint src scripts release tsdown.config.ts vite.config.ts vite.comparison.config.ts --max-warnings=0",
    "mcp": "pnpm build && node dist/mcp.js",
    "prepack": "pnpm build",
    "production:probe": "tsx scripts/production-acceptance.ts --edge-only",
    "production:deploy": "tsx scripts/production-deploy.ts",
    "publish:deployment-release": "tsx scripts/publish-release.ts",
    "production:test:features": "tsx scripts/production-acceptance.ts",
    "production:test:mutation": "tsx scripts/production-acceptance.ts --mutation",
    "release:apply": "tsx release/agent.ts --apply",
    "release:plan": "tsx release/agent.ts",
    "release:retry:check": "tsx release/retry.ts",
    "smoke": "tsx --test src/smoke.test.ts",
    "smoke:package": "tsx scripts/smoke-package.ts",
    "test": "tsx --test src/*.test.ts src/picker/*.test.ts release/*.test.ts scripts/*.test.mjs",
    "ui:showcase": "vite --open /showcase.html",
    "coverage": "node scripts/coverage.mjs"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "@inquirer/password": "^5.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^15.0.0",
    "html-to-text": "10.0.1",
    "jose": "^6.2.10",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260831.1",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@openai/apps-sdk-ui": "0.2.2",
    "@tailwindcss/vite": "4.1.18",
    "@types/html-to-text": "9.0.4",
    "@types/node": "22.20.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/semver": "7.8.0",
    "@vitejs/plugin-react": "5.2.0",
    "effect": "3.22.2",
    "eslint": "^10.9.1",
    "fp-ts": "2.16.11",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remeda": "2.48.0",
    "semver": "7.8.5",
    "tailwindcss": "4.1.18",
    "tsdown": "0.22.14",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "7.3.6",
    "vite-plugin-singlefile": "2.3.3",
    "wrangler": "4.127.1"
  }
}
