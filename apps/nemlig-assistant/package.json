{
  "name": "nemlig-assistant",
  "version": "6.2.0",
  "private": true,
  "description": "Safe local Nemlig Assistant CLI and MCP server",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/mortenbroesby/everyday-assistants#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mortenbroesby/everyday-assistants.git",
    "directory": "apps/nemlig-assistant"
  },
  "bugs": {
    "url": "https://github.com/mortenbroesby/everyday-assistants/issues"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "bin": {
    "nemlig": "dist/cli.js",
    "nemlig-assistant": "dist/cli.js",
    "nemlig-mcp": "dist/mcp.js",
    "nemlig-mcp-http": "dist/http.js"
  },
  "scripts": {
    "build": "tsdown && vite build && tsx scripts/check-product-viewer.ts",
    "build:ui": "vite build && tsx scripts/check-product-viewer.ts",
    "check:api": "node scripts/check-api-manifest.mjs",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "cloudflare:check": "wrangler deploy --dry-run --env production",
    "cloudflare:dev": "wrangler dev",
    "auth:local:doctor": "tsx scripts/auth-local.ts doctor",
    "auth:local:start": "wrangler dev --local --local-protocol https --ip 127.0.0.1 --port 8787 --persist-to .codex/local-auth/wrangler-state",
    "auth:local:test": "tsx scripts/auth-local.ts test",
    "bench:review-ui": "tsx scripts/benchmark-review-ui.ts",
    "cli": "pnpm build && node dist/cli.js",
    "check:version-bump": "tsx release/check-version-bump.ts",
    "check:release-note": "tsx release/release-note.ts",
    "lint": "eslint src scripts release tsdown.config.ts vite.config.ts --max-warnings=0",
    "mcp": "pnpm build && node dist/mcp.js",
    "prepack": "pnpm build",
    "production:probe": "tsx scripts/production-acceptance.ts --edge-only",
    "production:deploy": "tsx scripts/production-deploy.ts",
    "production:test:features": "tsx scripts/production-acceptance.ts",
    "release:apply": "tsx release/agent.ts --apply",
    "release:plan": "tsx release/agent.ts",
    "release:retry:check": "tsx release/retry.ts",
    "smoke": "tsx --test src/smoke.test.ts",
    "smoke:review-ui": "pnpm smoke:review-ui:adapter && pnpm smoke:review-ui:artifact",
    "smoke:review-ui:adapter": "tsx scripts/smoke-review-ui.ts",
    "smoke:review-ui:artifact": "tsx scripts/smoke-product-viewer.ts",
    "ui:mockup": "pnpm build:ui && NEMLIG_UI_SCREENSHOT_DIR=.codex/ui-mockups pnpm smoke:review-ui:artifact",
    "smoke:onboarding": "tsx scripts/smoke-onboarding.ts",
    "smoke:package": "tsx scripts/smoke-package.ts",
    "test": "tsx --test src/*.test.ts release/*.test.ts scripts/*.test.mjs",
    "coverage": "node scripts/coverage.mjs"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "@inquirer/password": "^5.2.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/express": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "commander": "^15.0.0",
    "effect": "3.22.2",
    "express": "5.2.1",
    "hono": "4.13.8",
    "html-to-text": "10.0.1",
    "jose": "^6.2.10",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260831.1",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@types/html-to-text": "9.0.4",
    "@types/node": "24.13.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/semver": "7.8.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "^10.9.1",
    "playwright": "1.62.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "semver": "7.8.5",
    "tsdown": "0.22.14",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "7.3.6",
    "vite-plugin-singlefile": "2.3.3",
    "wrangler": "4.127.1"
  },
  "nemligRelease": {
    "codename": "Rowan"
  }
}
